%train 



%% hyperparameter tuning
%% DATA

Fram_040_Init


%% GRID
% Restrict to the inner-CV training subset defined by you

% Fix class order across folds
classes = categories(Y_train);

if 1 %make parameter tuning

    %% YOUR CUSTOM BLOCK PARTITION (provided logic)
    nFolds = cv_inner.NumTestSets;

    %% HYPERPARAMETER GRID
    grid.sigmas = logspace(-3, 1, 10);
    grid.boxconstr  = logspace(0, 2, 11);

    P = numel(predictors);

    % %% EVALUATION FUNCTION (misclassification rate averaged over custom folds)
    % blockCVError = @(numTrees, boxconstr, mtry) mean( ...
    %     arrayfun(@(k) foldErr(k, numTrees, boxconstr, mtry, X_train, Y_train, cv_inner, classes), 1:nFolds) );

    %% TUNING + PLOTTING
    numSgm = numel(grid.sigmas);
    numC = numel(grid.boxconstr);

    ErrMaps = nan(numSgm, numC); 
    best.err = inf;

    tiledlayout('flow', 'TileSpacing','compact', 'Padding','compact');

    tParams = table();
    iRow = 1;
    for iSgm = 1:numSgm
        for iC = 1:numC
                tParams.sigmas(iRow) = grid.sigmas(iSgm);
                tParams.boxconstr(iRow) = grid.boxconstr(iC);
                iRow = iRow +1;
        end
    end

    errMat = NaN(height(tParams), 1);
    parfor iRow = 1:height(tParams)
        Sigma = tParams.sigmas(iRow);
        C = tParams.boxconstr(iRow);
        t = templateSVM( ...
    'KernelFunction', 'gaussian', ...  % RBF
    'KernelScale',    Sigma, ...         % sigma
    'BoxConstraint',  C, ...           % C
    'Standardize',    true, ...        % стандартизация признаков
    'Type',           'classification');

        errMat(iRow) = blockCVError( tParams.sigmas(iRow),  tParams.boxconstr(iRow),  tParams.mtry(iRow));
    end
    tParams.errMat = errMat;
    %%
    %plot the results
    for iSgm = 1:numSgm
        mtry = grid.Mtry(iSgm)  % external variable as requested
        % Compute error surface (boxconstr × sigmas) for this Mtry
        errMat = nan(numL, numN);
        for iC = 1:numL
            for iN = 1:numN
                ind = tParams.mtry == mtry & tParams.sigmas == grid.sigmas(iN) & tParams.boxconstr== grid.boxconstr(iC)
                errMat(iC, iN) = tParams.errMat(ind);
            end
        end
        ErrMaps(:,:,iSgm) = errMat;
    end
    minVal= min(ErrMaps(:));
    maxVal= max(ErrMaps(:));
    %%
    figure(1)
    clf
    best.err = Inf;
    for iSgm = 1:numSgm
        mtry = grid.Mtry(iSgm)  % external variable as requested
        errMat = ErrMaps(:,:,iSgm);
        % Best point on this surface
        [minVal, linIdx] = min(errMat(:));
        [iLbest, iNbest] = ind2sub(size(errMat), linIdx);
        Nbest = grid.sigmas(iNbest);
        Lbest = grid.boxconstr(iLbest);

        % Track global best
        if minVal < best.err
            best.err = minVal;
            best.NTrees  = Nbest;
            best.boxconstr = Lbest;
            best.Mtry    = mtry;
        end

        % ----- Contour plot for this Mtry -----
        nexttile;
        [NN, LL] = meshgrid(grid.sigmas, grid.boxconstr);
        contourf(NN, LL, errMat, 'ShowText','on'); colorbar;
        hold on;
        caxis([minVal, maxVal]);
        plot(Nbest, Lbest, 'wo', 'MarkerFaceColor','k', 'MarkerSize',6);
        hold off;
        xlabel('sigmas'); ylabel('MinLeafSize');
        title(sprintf('Block-CV error (custom folds), Mtry = %d', mtry));
        set(gca,'YDir','normal');
        drawnow
    end
    %%/ best =
    %
    %   struct with fields:
    %
    %         err: 0.5749
    %      NTrees: 100
    %     boxconstr: 10
    %        Mtry: 5
    %
    %
    fprintf('Best (custom block-CV): Err=%.4f, sigmas=%d, boxconstr=%d, Mtry=%d\n', ...
        best.err, best.NTrees, best.boxconstr, best.Mtry);
end
%% FINAL MODEL on the entire inner training subset (optional)

    nFolds = cv_inner.NumTestSets;
    %% EVALUATION FUNCTION (misclassification rate averaged over custom folds)
    blockCVError = @(sigmas, boxconstr, mtry) mean( ...
        arrayfun(@(k) foldErr(k, sigmas, boxconstr, mtry, X, Y, cv_inner, classes), 1:nFolds) );


nTrees = 200;
boxconstr = 10;
Mtry = 3;

 cvError = blockCVError(nTrees,  boxconstr, Mtry)
 disp(["CVError " + cvError])

Mdl1 = TreeBagger(nTrees, X_train, Y_train, ...
    'Method','classification', ...
    'MinLeafSize', boxconstr, ...
    'NumPredictorsToSample', Mtry, ...
    'Surrogate','off', ...
    'OOBPrediction','on', 'OOBPredictorImportance', 'on');

% OOB permutation importance (Δ OOB classification error per feature)

Fram_049_PlotResultsBag

function e = foldErr(k, numTrees, boxconstr, mtry, Xtr, Ytr, cv_inner, classes)
% Binary masks provided by your custom cvpartition
trMask = cv_inner.training(k);
teMask = cv_inner.test(k);

% Train Random Forest on training block
M = TreeBagger(numTrees, Xtr(trMask,:), Ytr(trMask), ...
    'Method','classification', ...
    'MinLeafSize', boxconstr, ...
    'NumPredictorsToSample', mtry, ...
    'Surrogate','off', ...
    'OOBPrediction','off');

% Predict on held-out block
Yhat = predict(M, Xtr(teMask,:));     % cellstr
Yhat = categorical(Yhat, classes);    % align class order
e = mean(Yhat ~= Ytr(teMask));        % misclassification rate
end