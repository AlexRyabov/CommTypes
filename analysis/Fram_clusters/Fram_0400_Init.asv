
%%

%% select the data
predictors_ctd = {'temp', 'cond', 'salin' 'sea_ice_now', 'sea_ice_week_before'};
predictors_env = {'temp', 'cond', 'salin', 'nitrate', 'nitrite', 'ammonium' ...
    'silicate', 'phosphate', 'sea_ice_now', 'sea_ice_week_before'};
predictors_sat_month = {'sea_ice_monthly', 'mod_aq_chl', 'mod_aq_nflh', ...
    'mod_aq_par', 'mod_aq_ipar', 'mod_aq_Kd_490', 'mod_aq_par_depth', 'mod_aq_pic', 'mod_aq_poc', ...
    'mod_aq_sst'};
% predictors_sat_month = {'sea_ice_monthly', 'mod_aq_chl', 'mod_aq_nflh', ...
%     'mod_aq_par', 'mod_aq_ipar', 'mod_aq_Kd_490', 'mod_aq_par_depth', 'mod_aq_pic', 'mod_aq_poc', ...
%     'mod_aq_sst'};
% predictors_env_imp = {'mod_aq_par_imputed', 'temp_imputed', 'nitrate_imputed', 'nitrite_imputed', 'ammonium_imputed', ...
%     'silicate_imputed', 'phosphate_imputed'};
predictors_env_imp_new = {'mod_aq_par_imputed', 'temp_imputed', ...
    'mld', 'wType', 'DIN_imputed', 'silicate_imputed', 'phosphate_imputed', ...
    'DIN_0_30_imputed', 'DIN_0_50_imputed', 'DIN_100_200_imputed'};
predictors_loc = {'Lat', 'Lon', 'Month_doy', 'Depth'};


switch LM_Model
    case 'Boost_all'
        predictors = [predictors_env, predictors_env_imp, predictors_sat_month, predictors_loc];
    case 'Boost_noimp'
        predictors = [predictors_env, predictors_sat_month, predictors_loc];
    case 'Boost_loc'
        predictors = [predictors_loc, {'Depth'}];
    case 'Boost_env'
        predictors = [predictors_env, {'Depth'}];
    case 'Boost_env_sat'
        predictors = [predictors_env, {'Depth'}];
    case 'Boost_ctd_impnutr'
        predictors = [predictors_env, {'Depth'}];
    case 'Boost_regular'
        predictors = {'temp', 'cond', 'salin', 'sea_ice_now',...
            'sea_ice_week_before', 'nitrate_imputed', 'nitrite_imputed',...
            'ammonium_imputed', 'silicate_imputed', 'phosphate_imputed', ...
            'sea_ice_monthly', 'mod_aq_par','mod_aq_par_depth', 'mod_aq_sst', 'Depth', 'Month_doy'};
    case 'Boost_regular_no_depthmonth'
        predictors = {'temp', 'cond', 'salin', 'sea_ice_now',...
            'sea_ice_week_before', 'nitrate_imputed', 'nitrite_imputed',...
            'ammonium_imputed', 'silicate_imputed', 'phosphate_imputed', ...
            'sea_ice_monthly', 'mod_aq_par','mod_aq_par_depth', 'mod_aq_sst'};
    case 'Boost_imp'  %regular important predictors
        predictors = {'mod_aq_par', 'nitrate_imputed', 'salin', 'phosphate_imputed', 'temp', 'cond', 'silicate_imputed'};
    case 'Boost_ctd_sat' %regularly sampled ctd and satellite data
        predictors = [{'Depth', 'temp', 'cond', 'salin', 'sea_ice_now', 'sea_ice_week_before'}, predictors_sat_month];
    case 'Boost_ctd_sat_no_depth,doy' %regularly sampled ctd and satellite data, no depth and doy
        predictors = [{'temp', 'cond', 'salin', 'sea_ice_now', 'sea_ice_week_before'}, predictors_sat_month];
    case 'Boost_sat_depth' %satellite data and depth
        predictors = [{'Depth'}, predictors_sat_month];
    case 'Boost_selected' %start from regular sampled and then remove less important
        predictors = [{'Depth', 'Month_doy'}, predictors_ctd, predictors_env_imp, predictors_sat_month];
    case 'Boost_most' %satellite, imputed nutrients, depth
        predictors = [{'Depth', 'Month_doy'}, predictors_ctd, predictors_env_imp];
    case 'Boost_best_varselect'  %after variable selection
        predictors = {'mod_aq_par', 'temp', 'nitrate_imputed', 'nitrite_imputed',...
            'silicate_imputed', 'phosphate_imputed'};
    case 'Boost_best_varselect+depth'  %after variable selection + depth
        predictors = {'mod_aq_par_imputed', 'temp_imputed', 'nitrate_imputed', 'nitrite_imputed',...
            'silicate_imputed', 'phosphate_imputed', 'Depth'};
    case 'Temp,Nutr,depth,Doy'  %Temp, nutr, depth and doy
        predictors = {'Depth', 'Month_doy', 'temp_imputed', 'nitrate_imputed', 'nitrite_imputed',...
            'silicate_imputed', 'phosphate_imputed'};
    case 'Boost_RegAndImputed' %regularly sampled ice data, imputed environment, depth and doy
        predictors = [{'Depth', 'Month_doy', 'sea_ice_now', 'sea_ice_monthly'}, predictors_env_imp];
    case 'Boost_RegAndImputedNew' %regularly sampled ice data, imputed environment, depth and doy new predictors DIN, DIN0_30... 
        predictors = [{'Depth', 'Month_doy', 'sea_ice_now', 'sea_ice_monthly'}, predictors_env_imp_new];
    case 'Boost_RegAndImputedNoDoy' %the same as Boost_RegAndImputed but not Doy
        predictors = [{'Depth', 'sea_ice_now', 'sea_ice_monthly'}, predictors_env_imp];
end

if ismember('wType', tStPredictors.Properties.VariableNames)
    tStPredictors.wType = integcategorical(tStPredictors.wType);
end


X = tStPredictors(:, predictors);



Y = categorical(tDMC.ClustID);  %select nonnan Y

[fg, MaxFigure] = addFindFigure('Present data', MaxFigure, [10, 20,400 400], 'normal', 'on');
t = nexttile
ind_missed_data = ismissing(X);
notMissed = sum(~ind_missed_data);
bar(predictors, notMissed)
%predictors(notMissed >700)';
ind_missed_rows  = sum(ind_missed_data, 2) >0;
X = X(~ind_missed_rows, :);
Y = Y(~ind_missed_rows);

% for blocked cross validation
Cruise = tStPredictors.Cruise(~ind_missed_rows);
MonthNum = tStPredictors.MonthNum(~ind_missed_rows);


if height(X) < 600
    error('too many rows were removeded')
end

%%
if 0 % split data by cruises
    %Choose the test year
    % [years_names, counts] = grpstats(Years, Years, {'gname', 'numel'});
    % sampled_years = find(counts > 20);
    % ind_Year_test = sampled_years(randi(length(sampled_years)));
    % Year_test = str2num(years_names{ind_Year_test});
    %Year_test = 2022;
    %Year_test = [2017, 2016];
    Cruise_test = {'PS107'};
    isTest  = ismember(Cruise, Cruise_test);
    disp("Data from " + Cruise_test + " used for testing")
    isTrain = ~isTest;
    Cruise_train = Cruise(isTrain);
    Cruise_test = Cruise(~isTrain);

    %Test and training
    X_train = X(isTrain, :);
    Y_train = Y(isTrain);
    X_test = X(isTest, :);
    Y_test = Y(isTest);



    %check the number of classes in the train and test
    %check the histogram
    [gnames, counts] = grpstats(Y, Y, {'gname', 'numel'});
    [gnames_tst, counts_tmp] = grpstats(Y_test, Y_test, {'gname', 'numel'});
    [iA, iB] = ismember(gnames_tst, gnames);
    counts_tst = zeros(size(counts));
    counts_tst(iB) = counts_tmp;

    [gnames_tr, counts_tmp] = grpstats(Y_train, Y_train, {'gname', 'numel'});
    [iA, iB] = ismember(gnames_tr, gnames);
    counts_tr = zeros(size(counts));
    counts_tr(iB) = counts_tmp;

    figure(1)
    clf
    bar([counts, counts_tr, counts_tst]);
    legend({'all', 'train', 'test'})


    %Make blocked cv-partition by the years
    cv_fold_id = Cruise(isTrain); %round((Cruise(isTrain)/2));
    uniqueFolds = unique(cv_fold_id);
    [~,cvGroups_train] = ismember(cv_fold_id,uniqueFolds,'R2012a');
    cv_inner = cvpartition("CustomPartition", cvGroups_train);
    %cv_inner = cvpartition(height(X_train), "Kfold", 5);
    nFolds = cv_inner.NumTestSets;

else  %split data into 5 folds and use only kfold cross validation
    ind_missed_data = ismissing(X);
    notMissed = sum(~ind_missed_data);
    bar(predictors, notMissed)
    %predictors(notMissed >700)';
    ind_missed_rows  = sum(ind_missed_data, 2) >0;
    X = X(~ind_missed_rows, :);
    Y = Y(~ind_missed_rows);
    if height(X) < 600
        error('too many rows were removeded')
    end

    % for blocked cross validation
    Cruise = tStPredictors.Cruise(~ind_missed_rows);
    MonthNum = tStPredictors.MonthNum(~ind_missed_rows);




    if HGP.ML.CVBlocked
        [foldIdx, cruiseFold] = makeCruiseMonthFolds(Cruise, MonthNum, HGP.ML.KFolds);
        cv_inner = cvpartition("CustomPartition", foldIdx);
    else  %location, stratification by month, no blocks by year
        cv_inner = cvpartition(MonthNum, "Kfold", HGP.ML.KFolds, 'Stratify',true);
    end
    nFolds = cv_inner.NumTestSets;

    %Test and training
    X_train = X(:, :);
    Y_train = Y(:);
    X_test = [];
    Y_test = [];

end



